# Frontend environment configuration.
#
# Every value here is optional. With no .env file the web app talks to
# http://localhost:4000 and uses http://localhost:3000 for absolute URLs
# (Open Graph images, canonical links).
#
# These are NEXT_PUBLIC_* so they are inlined into the client bundle at build
# time. Changing one requires a rebuild, not just a restart.

# Base URL of the Bizora API, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this deployment. Used for metadata and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000