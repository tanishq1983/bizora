# ─────────────────────────────────────────────────────────────────────────────
# Bizora — environment configuration
#
# THE APP RUNS WITH ZERO CONFIGURATION. Every setting below is optional.
# With no .env file at all, Bizora boots with:
#   • AI provider  → deterministic mock (no GEMINI_API_KEY)
#   • Data store   → in-memory (no SUPABASE_*)
#   • Auth mode    → guest founder (no Supabase Auth)
#
# Add credentials progressively and the app upgrades itself with no code change.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
AI_TIMEOUT_MS=45000

# ── AI Provider ─────────────────────────────────────────────────────────────
# auto  = use Gemini when GEMINI_API_KEY is set, otherwise the mock provider
# gemini= force Gemini (fail loudly if the key is missing or the call fails)
# mock  = force the deterministic mock provider
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Data Store ──────────────────────────────────────────────────────────────
# auto     = Supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set
# supabase = force Postgres via Supabase
# memory   = force the in-process store
DATA_STORE=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
# auto     = Supabase Auth when configured, otherwise guest founder identity
# supabase = require real sign-in
# guest    = always use the auto-provisioned demo identity
AUTH_MODE=auto
# HMAC secret used to sign guest session tokens. Change this in production.
GUEST_TOKEN_SECRET=dev-only-insecure-secret-change-me